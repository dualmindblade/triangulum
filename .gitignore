# generated planet data (rebuild: python -m planetgen, then the bake scripts)
output/
viewer/assets/*.bin
viewer/assets/meta.json
# journaled multiplayer/edit state - session-local, regenerated on play
viewer/assets/*.edj2
viewer/assets/*.edt1

# screenshots and visual-feedback exchange (session-local, often large).
# Durable evidence does NOT live here - reviews, handoffs and mission
# findings go in docs/ so they survive a worktree removal. Evidence has
# been lost to this rule before (the L-1 border captures).
viewer/interchange/*
!viewer/interchange/tint_*.png
!viewer/interchange/v7_*.png

# EXCEPTION: the blessed gate baselines ARE tracked (Austin, 2026-07-28).
# They are the references every visual gate compares against, and they encode
# accumulated human blessing decisions. Untracked, they existed only on one
# machine: a fresh clone had no working gates, and every dispatched worktree
# mission silently degraded to "everything looks new" until the coordinator
# hand-copied them in. Tracking them also makes `--accept` produce a
# reviewable diff, which is what a human decision ought to leave behind.
# Only the `accepted` references are tracked - `current.json` and the run
# directories stay session-local.
!viewer/interchange/reel/
viewer/interchange/reel/*
!viewer/interchange/reel/accepted/
!viewer/interchange/skyreel/
viewer/interchange/skyreel/*
!viewer/interchange/skyreel/accepted/
!viewer/interchange/perfreel/
viewer/interchange/perfreel/*
!viewer/interchange/perfreel/accepted.json
!viewer/interchange/convreel/
viewer/interchange/convreel/*
!viewer/interchange/convreel/accepted.json
!viewer/interchange/convflight/
viewer/interchange/convflight/*
!viewer/interchange/convflight/accepted.json

# reel/ladder-generated .play scripts (_perf_*, _conv_*, _convflight_*,
# _altitude-*): written fresh on every run, so they are outputs, not
# sources. The leading underscore marks them - never hand-edit these.
viewer/scripts/_*.play

# build artifacts
__pycache__/
*.pyc
viewer/target/
/target/

# local secrets - never commit
.cloudfare-creds
.tunnel-token

# local tool binaries (cloudflared etc.)
/tools/
.game-token
server-run.log
server-run.err
tunnel-run.log
tunnel-run.err

# per-machine Claude Code settings (permissions differ per operator)
.claude/settings.local.json
.claude/worktrees/

# New engine (Oct 2026): build output, baked worlds, saves, bench captures
game/target/
game/assets/world/
game/saves/
game/out/
# replays recorded with F10 (send them; don't commit them)
game/replays/
# photos and notes: send them; don't commit them
game/interchange/
crates/*/target/
