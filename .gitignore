# generated planet data (rebuild: python -m planetgen, then the bake scripts)
output/
viewer/assets/*.bin
viewer/assets/meta.json

# screenshots and visual-feedback exchange (session-local, often large).
# Transition missions keep only their explicitly named review evidence.
viewer/interchange/*
!viewer/interchange/tint_*.png
!viewer/interchange/v7_*.png

# reel/ladder-generated .play scripts: written fresh on every run, so they
# are outputs, not sources (_perf_*, _conv_*, _convflight_*, _altitude-*).
viewer/scripts/_*.play

# build artifacts
__pycache__/
*.pyc
viewer/target/
/target/

# local secrets - never commit
.cloudfare-creds
.tunnel-token

# local tool binaries (cloudflared etc.)
/tools/
.game-token
server-run.log
server-run.err
tunnel-run.log
tunnel-run.err
