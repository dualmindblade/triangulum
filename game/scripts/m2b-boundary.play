# M2b: the boundary of the active region. Water flowing in a trench freezes
# when the player walks far enough away for its chunk to leave the region,
# holds exactly its levels while away, and finishes when the player comes
# back; then a pit at the shore with a region so small that the sea beyond
# it is the generator's reservoir: water flows in through the boundary, is
# counted, and the frozen sea beyond is never written.
#
# Sites as in m2b-water.play. `sim radius 1` makes the region the chunks
# whose bounding sphere (about 28 m) comes within a metre of the player;
# site A's trench chunk is centred 1.5 m east of the player, so flying 300 m
# west at 1,000 m/s (0.3 s, six ticks; 33 m by the second step) drops it from
# the region at the first tick of the flight, while the water is exactly two
# ticks into its flow.

# ---- 1. Site A: hole, trench, one cell of water, two ticks of flow --------
atblock 2 107157 57531 2512
assert mode == walk
# T2: the ground here is no longer level (the hills are real now), so the
# scene stands on a stone tray laid over it, as in m2b-water.play: five
# layers of stone under the feet, air above, a rim at feet level 31 blocks
# out. The tray is laid and its notifications drained with the full region
# (its chunks are all active), before the region shrinks to one chunk. The
# tray's ticks are an even number (20 for the drop, 4 to drain) so the pour's
# ticks keep the parity the second-tick levels below were written for (the
# spread pass alternates direction every tick; see m2b-water.play).
sim off
fill -34 -34 -6 34 34 -2 stone
fill -34 -34 -1 34 34 4 air
fill -31 -31 -1 31 31 -1 stone
fill -30 -30 -1 30 30 -1 air
sim on
wait 1
assert on_ground == true
tick 4
assert queued == 0
assert frozen == 0
sim radius 1
assert sim_radius == 1
lookaxis +i 0
aim 1 0 -0.5
tap break
aim 1 0 -1.5
tap break
atblock 2 107153 57531 2512
lookaxis +i 0
aim 1 0 -0.5
tap break
aim 2 0 -0.5
tap break
aim 3 0 -0.5
tap break
aim 4 0 -0.5
tap break
assert block_rel[5,0,-2] == air
assert block_rel[5,0,-3] != air
tick 2
assert queued == 0
select 9
aim 1 0 -1.5
tap place
assert level_rel[1,0,-1] == 255
tick 2
# C2 (rules 4): the cell at the near end looks along the trench to the pit
# and sends half its water there in the second tick
assert level_rel[1,0,-1] == 64
assert level_rel[2,0,-1] == 64
assert level_rel[3,0,-1] == 63
assert queued > 0
assert frozen == 0

# ---- 2. walk away: the trench's chunk leaves the region and freezes --------
mode fly
speed 1000
lookaxis -i 0
hold w 0.3
tick 1
assert frozen > 0
assert queued == 0
tick 40
assert frozen > 0
assert queued == 0
# nothing moved while away: the levels are exactly as left
sim off
mode walk
atblock 2 107153 57531 2512
assert level_rel[1,0,-1] == 64
assert level_rel[2,0,-1] == 64
assert level_rel[3,0,-1] == 63
assert level_rel[4,0,-1] == 0
assert level_rel[5,0,-2] == 64
assert water_rel[1,-1,-3,5,1,0] == 255

# ---- 3. back: the frozen updates wake and the water finishes ---------------
sim on
tick 1
assert frozen == 0
assert queued > 0
tick 120
assert queued == 0
assert frozen == 0
assert water_rel[1,-1,-3,5,1,0] == 255
assert level_rel[5,0,-2] >= 225
assert level_rel[1,0,-1] <= 6
assert water_in == 0
assert water_out == 0
state trench

# ---- 4. Site B with a one-chunk region: the sea beyond the edge feeds the pit
# B4: the same beach-sand pit as m2b-water.play: its walls stand here too.
sim slide off
atblock 1 1989 59004 1023
mode fly
select 1
# Hover a layer up: the beach is level here, and a ray from the ground grazes it.
atblock 1 1989 59004 1024
lookaxis -i 0
aim -3 0 -1.5
tap break
aim -3 -1 -1.5
tap break
aim -3 1 -1.5
tap break
aim -2 0 -1.5
tap break
aim -2 -1 -1.5
tap break
aim -2 1 -1.5
tap break
aim -1 0 -1.5
tap break
aim -1 -1 -1.5
tap break
aim -1 1 -1.5
tap break
# the lower layer from inside the pit (a steep ray from the shore would clip
# the player's own ground block): hover in the pit's middle upper cell
atblock 1 1987 59004 1022
aim 0 0 -0.5
assert crosshair == sand
tap break
aim -1 0 -0.5
tap break
aim 1 0 -0.5
tap break
aim 0 -1 -0.5
tap break
aim 0 1 -0.5
tap break
aim -1 -1 -0.5
tap break
aim -1 1 -0.5
tap break
aim 1 -1 -0.5
tap break
aim 1 1 -0.5
tap break
atblock 1 1989 59004 1024
lookaxis -i 0
assert block[1,1986,59004,1022] == air
tick 1
assert sim_active_chunks < 10
tick 250
assert queued == 0
assert level[1,1986,59004,1022] == 255
assert level[1,1988,59005,1022] == 255
assert level[1,1987,59004,1023] >= 200
# the chunk's -i side is i 1792: beyond it the sea is the generator's, frozen
# and full, and the cell just inside leans on it
assert level[1,1977,59004,1023] == 255
assert level[1,1976,59004,1023] == 255
assert level[1,1978,59004,1023] >= 250
assert water_in > 0
assert water_out == 0
assert water_lost == 0
aim -2 0 -2.0
shot 07_pit_fed_through_the_boundary
assert tick_ms_avg < 2
state final
