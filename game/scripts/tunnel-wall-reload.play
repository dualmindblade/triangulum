# Review 2 #7: a tunnel wall that belongs to a chunk nobody dug in.
#
# Column (face 2, i 107672, j 57752) near the hills: its ground block is at
# layer 1049, the bottom layer of its LOD-0 chunk (cz 32) is 1024, and the
# chunk under that (cz 31, layers 992..1023) is naturally Enclosed: solid
# through its padding, so the streamer never makes a node of it on its own.
# Digging the shaft down to layer 1024 exposes the top face of block 1023,
# which only that buried chunk's mesh can draw. Live, the dig's
# invalidation materialises it under its parent and it is drawn; the
# reload rebuilds the tree from the roots through the admission test,
# which, before the fix, knew nothing of the dig next door, so the shaft
# had no floor from then on (and after any merge and re-split).
#
# Fly mode: "hold ctrl 0.05" descends exactly one layer, so 26 cycles of
# aim, break, descend dig layers 1049 down to 1024 without falling.
#
#   cargo run --release -- --play scripts/tunnel-wall-reload.play
#
# cover_rel[DI,DJ,DK] (after a shot) says what the streamer's cut shows at
# a block: the fix is "drawn:0" at the block under the feet, where it used
# to be the coarse LOD-4 ancestor, which has no face there.
mode fly
atblock 2 107672 57752 1049
assert mode == fly
assert block_rel[0,0,-1] != air
assert block_rel[0,0,0] == air
assert k == 1050
shot 01_surface
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
assert k == 1024
assert block[2,107672,57752,1024] == air
assert block[2,107672,57752,1049] == air
assert block_rel[0,0,-1] != air
assert block[2,107672,57752,1023] != air
look 0 -89
shot 02_shaft_bottom_live
# The shaft's own chunk draws its walls; the chunk under the floor must
# draw the floor.
assert cover_rel[1,0,0] == drawn:0
assert cover_rel[0,0,-1] == drawn:0
save
assert dirty == 0
reload
assert block[2,107672,57752,1024] == air
assert block[2,107672,57752,1023] != air
shot 03_shaft_bottom_reloaded
assert cover_rel[1,0,0] == drawn:0
assert cover_rel[0,0,-1] == drawn:0
# From the top of the shaft, looking down it.
hold space 1.3
assert k == 1050
look 0 -89.9
shot 04_down_the_shaft
assert cover_rel[0,0,-27] == drawn:0
