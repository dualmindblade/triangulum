# Review 2 #7: a tunnel wall that belongs to a chunk nobody dug in.
#
# Column (face 2, i 107672, j 57752) near the hills: its ground block is at
# layer 537, the bottom layer of its LOD-0 chunk (cz 16) is 512, and the
# chunk under that (cz 15, layers 480..511) is naturally Enclosed: solid
# through its padding, so the streamer never makes a node of it on its own.
# Digging the shaft down to layer 512 exposes the top face of block 511,
# which only that buried chunk's mesh can draw. The two chunks' ancestors
# meet only at LOD 5 (cz 16 and 15 sit in different parents up to there),
# so the buried chunk is not a sibling of the dug one: before the fix it
# was never admitted, live or after a reload, and the shaft had no floor.
#
# Fly mode: "hold ctrl 0.05" descends exactly one layer, so 26 cycles of
# aim, break, descend dig layers 537 down to 512 without falling.
#
#   cargo run --release -- --play scripts/tunnel-wall-reload.play
#
# cover_rel[DI,DJ,DK] (after a shot) says what the streamer's cut shows at
# a block: the fix is "drawn:0" at the block under the feet, where it used
# to be the coarse LOD-4 ancestor, which has no face there.
mode fly
atblock 2 107672 57752 537
assert mode == fly
assert block_rel[0,0,-1] != air
assert block_rel[0,0,0] == air
assert k == 538
shot 01_surface
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
aim 0 0 -0.5
tap break
hold ctrl 0.05
assert k == 512
assert block[2,107672,57752,512] == air
assert block[2,107672,57752,537] == air
assert block_rel[0,0,-1] != air
assert block[2,107672,57752,511] != air
look 0 -89
shot 02_shaft_bottom_live
# The shaft's own chunk draws its walls; the chunk under the floor must
# draw the floor.
assert cover_rel[1,0,0] == drawn:0
assert cover_rel[0,0,-1] == drawn:0
save
assert dirty == 0
reload
assert block[2,107672,57752,512] == air
assert block[2,107672,57752,511] != air
shot 03_shaft_bottom_reloaded
assert cover_rel[1,0,0] == drawn:0
assert cover_rel[0,0,-1] == drawn:0
# From the top of the shaft, looking down it.
hold space 1.3
assert k == 538
look 0 -89.9
shot 04_down_the_shaft
assert cover_rel[0,0,-27] == drawn:0
