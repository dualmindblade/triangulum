# Round 2 #4 (T3, boundaries): one point on each kind of line, from orbit down to
# standing on it, straight down at noon. Each height is drawn at a coarser LOD,
# so the claim to check is that the line keeps its character all the way. The
# points are on the lines of the T3 build; the frozen build's frames at the same
# places show what was there. Not a gate; nothing is asserted.
#
#   <exe> --bake DIR --no-save --size 1920x1080 --play scripts/t3-ladder.play --out OUT
#
# Heights are metres above sea level, not layers: nothing here moves with sea level.
mode fly

# --- A lake shore, Andrew's lake
at 6.98382 38.65730 150000
skytime 12:00
look 0 -89.9
photo lake_150km
at 6.98382 38.65730 40000
look 0 -89.9
photo lake_40km
at 6.98382 38.65730 10000
look 0 -89.9
photo lake_10km
at 6.98382 38.65730 2500
look 0 -89.9
photo lake_2500m
at 6.98382 38.65730 600
look 0 -89.9
photo lake_600m
at 6.98382 38.65730 150
look 0 -89.9
photo lake_150m
at 6.98382 38.65730 40
look 0 -89.9
photo lake_40m
at 6.98382 38.65730 12
look 40 -35
photo lake_foot

