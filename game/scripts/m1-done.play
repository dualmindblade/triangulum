# M1 "done when": walk on Neisor, dig a tunnel, build a bridge, save, reload,
# check the edited blocks, and see the bridge from far away.
#
# Terrain-independent: nothing here assumes how high the ground is or what it
# is made of, so the script survives generator changes. Every height is
# relative to where the player stands (block_rel[di,dj,dk], dk 0 = the feet
# block), and every check is about what the edits did.
#
#   atblock F I J 2000   stands on whatever is the top solid block of
#                        column (I, J): the ground, or a block built there
#   fly mode             no collision, 20 m/s, and placing into one's own
#                        cell is allowed; at a fixed 60 Hz step,
#                        "hold w 0.05" moves exactly 1 m and "hold space
#                        0.05" rises exactly one layer
#   aim DI DJ DK         targets a point relative to the feet cell, so picks
#                        are exact whatever the sub-cell position
#
# `edits` counts edited chunks (all of this sits in one or two), not blocks.
#
# Layout on face 2, all along the i axis of row J = 57519 (the hills preset):
#   pillar  column I = 107156: five stone blocks on the ground (layers G..G+4)
#   deck    columns I+1..I+6 at layer G+4, one block wide: the bridge
#   shaft   column I-4: dug straight down five blocks from its own ground
#   tunnel  from the shaft bottom along -i, four cells long, two high
# Below the surface everything is rock, so the shaft and the tunnel are the
# same on any terrain. The deck needs only that the ground under it stays
# below its underside, which holds on any gentle slope.

# ---- 1. walk to the site ---------------------------------------------------
atblock 2 107156 57519 2000
lookaxis +i 0
assert mode == walk
assert on_ground == true
assert block_rel[0,0,-1] != air
assert block_rel[0,0,0] == air
assert block_rel[0,0,1] == air
shot 01_start

# ---- 2. a stone pillar, five blocks tall (place into one's own cell, rise) ---
mode fly
select 1
assert selected_block == stone
aim 0 0 -0.5
assert crosshair != none
tap place
assert block_rel[0,0,0] == stone
hold space 0.05
aim 0 0 -0.5
assert crosshair == stone
tap place
assert block_rel[0,0,0] == stone
assert block_rel[0,0,-1] == stone
hold space 0.05
aim 0 0 -0.5
tap place
assert block_rel[0,0,0] == stone
hold space 0.05
aim 0 0 -0.5
tap place
assert block_rel[0,0,0] == stone
hold space 0.05
aim 0 0 -0.5
tap place
assert block_rel[0,0,0] == stone
assert block_rel[0,0,-4] == stone
assert edits >= 1

# ---- 3. the bridge deck: six blocks out along +i at the pillar top's level --
# Each block: stand on the last one, fly one cell on and one layer down (into
# the cell the next block fills) and place it against the last block's +i face.
mode walk
atblock 2 107156 57519 2000
assert block_rel[0,0,-1] == stone
mode fly
lookaxis +i 0
hold w 0.05
hold ctrl 0.05
aim -0.5 0 0.5
assert crosshair == stone
tap place
assert block_rel[0,0,0] == stone
assert block_rel[-1,0,0] == stone
mode walk
atblock 2 107157 57519 2000
assert block_rel[0,0,-1] == stone
mode fly
lookaxis +i 0
hold w 0.05
hold ctrl 0.05
aim -0.5 0 0.5
assert crosshair == stone
tap place
assert block_rel[0,0,0] == stone
mode walk
atblock 2 107158 57519 2000
assert block_rel[0,0,-1] == stone
mode fly
lookaxis +i 0
hold w 0.05
hold ctrl 0.05
aim -0.5 0 0.5
tap place
assert block_rel[0,0,0] == stone
mode walk
atblock 2 107159 57519 2000
assert block_rel[0,0,-1] == stone
mode fly
lookaxis +i 0
hold w 0.05
hold ctrl 0.05
aim -0.5 0 0.5
tap place
assert block_rel[0,0,0] == stone
mode walk
atblock 2 107160 57519 2000
assert block_rel[0,0,-1] == stone
mode fly
lookaxis +i 0
hold w 0.05
hold ctrl 0.05
aim -0.5 0 0.5
tap place
assert block_rel[0,0,0] == stone
mode walk
atblock 2 107161 57519 2000
assert block_rel[0,0,-1] == stone
mode fly
lookaxis +i 0
hold w 0.05
hold ctrl 0.05
aim -0.5 0 0.5
tap place
assert block_rel[0,0,0] == stone
assert edits >= 1
mode walk

# ---- 4. walk out along the deck and jump on it -------------------------------
atblock 2 107156 57519 2000
lookaxis +i 0
hold w 1.0
assert on_ground == true
assert speed > 4
assert block_rel[0,0,-1] == stone
assert block_rel[0,0,-2] == air
assert block_rel[0,0,-3] == air
tap jump
wait 0.25
assert on_ground == false
wait 1
assert on_ground == true
assert block_rel[0,0,-1] == stone
atblock 2 107153 57516 2000
mode fly
hold space 0.3
aim 6.0 3.0 -3.0
shot 04_bridge
mode walk

# ---- 5. dig a shaft five blocks down, then a tunnel along -i ----------------
atblock 2 107152 57519 2000
assert on_ground == true
aim 0 0 -0.5
assert crosshair != none
tap break
wait 0.6
assert on_ground == true
assert block_rel[0,0,1] == air
aim 0 0 -0.5
tap break
wait 0.6
assert on_ground == true
assert block_rel[0,0,2] == air
aim 0 0 -0.5
tap break
wait 0.6
aim 0 0 -0.5
tap break
wait 0.6
aim 0 0 -0.5
tap break
wait 0.6
assert on_ground == true
assert block_rel[0,0,0] == air
assert block_rel[0,0,1] == air
assert block_rel[0,0,2] == air
assert block_rel[0,0,3] == air
assert block_rel[0,0,4] == air
assert block_rel[0,0,-1] != air
# the tunnel: break the cell ahead at the head, then at the feet (a ray to the
# feet-level cell from the eye enters the next column at head height), step in;
# four times
aim -1 0 1.5
assert crosshair != none
tap break
assert block_rel[-1,0,1] == air
aim -1 0 0.5
tap break
assert block_rel[-1,0,0] == air
lookaxis -i 0
hold w 0.5
assert on_ground == true
assert block_rel[1,0,0] == air
assert block_rel[1,0,1] == air
assert block_rel[-1,0,0] != air
aim -1 0 1.5
tap break
assert block_rel[-1,0,1] == air
aim -1 0 0.5
tap break
assert block_rel[-1,0,0] == air
lookaxis -i 0
hold w 0.5
assert block_rel[1,0,0] == air
aim -1 0 1.5
tap break
assert block_rel[-1,0,1] == air
aim -1 0 0.5
tap break
assert block_rel[-1,0,0] == air
lookaxis -i 0
hold w 0.5
assert block_rel[1,0,0] == air
aim -1 0 1.5
tap break
assert block_rel[-1,0,1] == air
aim -1 0 0.5
tap break
assert block_rel[-1,0,0] == air
lookaxis -i 0
hold w 0.5
assert on_ground == true
assert block_rel[0,0,0] == air
assert block_rel[0,0,1] == air
assert block_rel[0,0,-1] != air
assert block_rel[-1,0,0] != air
assert block_rel[4,0,0] == air
assert block_rel[4,0,5] == air
assert edits >= 1
lookaxis +i 5
shot 03_tunnel

# ---- 6. the deck from underneath --------------------------------------------
atblock 2 107159 57519 2000
assert block_rel[0,0,-1] == stone
mode fly
hold ctrl 0.15
aim 0 0 2.5
assert crosshair == stone
shot 04_under_bridge
mode walk

# ---- 7. save, reload (quit and start again), check every edit ---------------
atblock 2 107159 57519 2000
save
assert dirty == 0
reload
assert edits >= 1
# the pillar
atblock 2 107156 57519 2000
assert block_rel[0,0,-1] == stone
assert block_rel[0,0,-5] == stone
# the deck, end to end, with air under it
atblock 2 107157 57519 2000
assert block_rel[0,0,-1] == stone
assert block_rel[0,0,-2] == air
atblock 2 107162 57519 2000
assert block_rel[0,0,-1] == stone
assert block_rel[0,0,-2] == air
assert block_rel[1,0,-1] == air
# the shaft (standing at its bottom) and the tunnel
atblock 2 107152 57519 2000
assert block_rel[0,0,0] == air
assert block_rel[0,0,4] == air
assert block_rel[0,0,-1] != air
assert block_rel[-1,0,0] == air
assert block_rel[-4,0,1] == air
assert block_rel[-5,0,0] != air
lookaxis -i 5
shot 05_reloaded

# ---- 8. the bridge from a distance: 300 m, 550 m and 1 km back along -j ------
# Fly mode is exact (20 m/s, 60 Hz): 15 s is 300 m, and the climb puts the eye
# about 42, 62 and 92 m above the deck, which sets the pitches.
atblock 2 107159 57519 2000
mode fly
lookaxis -j 0
hold w 15
hold space 2
lookaxis +j -7.9
shot 06_bridge_300m
lookaxis -j 0
hold w 12.5
hold space 1
lookaxis +j -6.4
shot 06_bridge_550m
lookaxis -j 0
hold w 22.5
hold space 1.5
lookaxis +j -5.2
shot 07_bridge_1km
bench 120
assert bench_fps > 60
