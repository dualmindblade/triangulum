# M2b: water. Pour water into a trench that ends in a drop, watch it slope
# along the trench and fall in (levels asserted tick by tick, the total
# conserved, settled within a budget); then dig a pit at the sea shore and
# open a channel inland: the pit and the channel fill, the sea stays full.
#
# Terrain-independent in the m1-done.play sense: every height is relative to
# where the player stands (dk 0 = the feet block), every level is asserted
# relative to the feet or at a lattice cell the probe scripts checked, and
# every check is about what the edits and the water did. Site A is the flat
# patch of m2a-sand.play (row J = 57531, columns 107153..107159, level
# ground). Site B is the shore the water tests found on face 1: the sea's
# surface cell at (1985, 59004, 511), sand from i 1986 with its top block at
# k 511, air above, and the shore straight across rows 59003..59005
# (probe-shore.play).
#
#   tick N: N simulation ticks (20 Hz) with no input. A full cell beside one
#   empty trench cell splits 127 / 128 in one tick (the remainder goes to
#   the neighbour); a cell with air below falls one cell per tick; a cell
#   that just arrived by falling spreads in the same tick if nothing is
#   below it. Water is key 9 (the bucket): the pick ray then stops at water,
#   so a right click on a film places a cell above it, which falls in.
#   Digging the deep cell of the hole needs a steep ray: from next to it.

# ---- 1. Site A: a two-deep hole at +5, then a trench one deep from +1 to +4
atblock 2 107157 57531 2512
assert mode == walk
assert on_ground == true
assert sim_enabled == true
# T2: the ground here is no longer level (the hills are real now), so the
# scene stands on a stone tray laid over it: five layers of stone under the
# feet, air above, and a rim at feet level 31 blocks out that keeps the
# poured film inside the box the asserts measure. The player drops one block
# onto the tray; every height below is relative to the feet, as before.
# The spread pass alternates direction every tick, and the second-tick
# levels below (64 / 64 / 63 and 64 in the pit) are the even-tick order,
# the one the scene had when it started at tick 0: the tray's ticks here are
# an even number (20 for the drop, 4 to drain), so the pour's ticks keep
# their parity. An odd count gives 96 / 96 / 63 and nothing in the pit yet.
sim off
fill -34 -34 -6 34 34 -2 stone
fill -34 -34 -1 34 34 4 air
fill -31 -31 -1 31 31 -1 stone
fill -30 -30 -1 30 30 -1 air
sim on
wait 1
assert on_ground == true
tick 4
assert queued == 0
lookaxis +i 0
aim 1 0 -0.5
assert crosshair != none
tap break
aim 1 0 -1.5
tap break
assert block_rel[1,0,-1] == air
assert block_rel[1,0,-2] == air
assert block_rel[1,0,-3] != air
atblock 2 107153 57531 2512
lookaxis +i 0
aim 1 0 -0.5
tap break
aim 2 0 -0.5
tap break
aim 3 0 -0.5
tap break
aim 4 0 -0.5
tap break
assert block_rel[1,0,-1] == air
assert block_rel[2,0,-1] == air
assert block_rel[3,0,-1] == air
assert block_rel[4,0,-1] == air
assert block_rel[5,0,-1] == air
assert block_rel[5,0,-2] == air
assert block_rel[5,0,-3] != air
assert block_rel[1,0,-2] != air
assert block_rel[1,1,-1] != air
assert block_rel[1,-1,-1] != air
tick 2
assert queued == 0
assert water_moved == 0

# ---- 2. one full cell at the near end: it splits, slopes and drops in ----
select 9
assert selected_block == water
aim 1 0 -1.5
assert crosshair != none
tap place
assert block_rel[1,0,-1] == water
assert level_rel[1,0,-1] == 255
assert water_placed == 255
assert water_rel[1,-1,-3,5,1,0] == 255
tick 1
# C2 (rules 4): the remainder of a spread stays with the spreading cell, and a
# cell that cannot spread looks along the trench to the pit at its end
assert level_rel[1,0,-1] == 128
assert level_rel[2,0,-1] == 127
assert level_rel[3,0,-1] == 0
assert water_rel[1,-1,-3,5,1,0] == 255
tick 1
assert level_rel[1,0,-1] == 64
assert level_rel[2,0,-1] == 64
assert level_rel[3,0,-1] == 63
assert water_rel[1,-1,-3,5,1,0] == 255
mode fly
hold space 0.12
aim 3 0 -1.0
shot 01_slope
mode walk
tick 6
# the pit at the trench's end has taken water (the lip cell over it stays dry
# since C2; the feet are a layer up here after the hop, so the pit is -3)
assert level_rel[5,0,-3] > 0
assert water_rel[1,-1,-3,5,1,0] == 255
mode fly
hold space 0.12
aim 4 0 -1.5
shot 02_drop
mode walk
tick 80
assert queued == 0
assert water_rel[1,-1,-3,5,1,0] == 255
assert level_rel[5,0,-2] >= 225
assert level_rel[5,0,-1] == 0
assert level_rel[1,0,-1] <= 6
assert level_rel[4,0,-1] <= 3
assert water_lost == 0
assert water_in == 0
assert water_out == 0

# ---- 3. two more cells poured onto the film from above: the hole fills to the
#         brim and the trench holds the rest, within a lean of one per cell
mode fly
hold space 0.1
aim 1 0 -1.5
# B4: under seek+dry the film has already run down into the hole, so the ray
# reaches the trench's dirt floor, not water; the cell placed is the same.
assert crosshair != none
tap place
assert water_placed == 510
tick 1
aim 1 0 -1.5
tap place
assert water_placed == 765
tick 5
aim 4 0 -1.5
shot 03_fall_into_the_hole
mode walk
tick 150
assert queued == 0
assert level_rel[5,0,-2] == 255
assert level_rel[5,0,-1] >= 90
assert level_rel[5,0,-1] <= 110
assert level_rel[1,0,-1] >= 90
assert level_rel[1,0,-1] <= 110
# B4: the third pour lands on a full cell and spreads over the grass, and that
# film now runs off the patch down the nearest natural step, so the box is wider.
assert water_rel[-30,-30,-14,30,30,1] == 765
assert water_balance == 765
state site_a

# ---- 4. Site B: a pit at the shore fills from the sea; the sea stays full ----
# B4: the walls of this pit are beach sand, and under the slide they slump into
# it. This part is about the water, so they stand (the old rule, for this site
# only); b4-slide.play digs the same beach under the new one.
sim slide off
atblock 1 1989 59004 1023
assert on_ground == true
assert block[1,1985,59004,1023] == water
assert level[1,1985,59004,1023] == 255
assert block[1,1986,59004,1023] == sand
assert block[1,1986,59004,1022] == sand
assert block[1,1986,59004,1024] == air
mode fly
select 1
# Hover a layer up: the beach is level here, and a ray from the ground grazes it.
atblock 1 1989 59004 1024
lookaxis -i 0
# the 3 x 3 x 2 pit: i 1986..1988, j 59003..59005, k 511 then 510
aim -3 0 -1.5
assert crosshair == sand
tap break
aim -3 -1 -1.5
tap break
aim -3 1 -1.5
tap break
aim -2 0 -1.5
tap break
aim -2 -1 -1.5
tap break
aim -2 1 -1.5
tap break
aim -1 0 -1.5
tap break
aim -1 -1 -1.5
tap break
aim -1 1 -1.5
tap break
# the lower layer from inside the pit (a steep ray from the shore would clip
# the player's own ground block): hover in the pit's middle upper cell
atblock 1 1987 59004 1022
aim 0 0 -0.5
assert crosshair == sand
tap break
aim -1 0 -0.5
tap break
aim 1 0 -0.5
tap break
aim 0 -1 -0.5
tap break
aim 0 1 -0.5
tap break
aim -1 -1 -0.5
tap break
aim -1 1 -0.5
tap break
aim 1 -1 -0.5
tap break
aim 1 1 -0.5
tap break
atblock 1 1989 59004 1024
lookaxis -i 0
assert block[1,1986,59004,1023] == air
assert block[1,1986,59004,1022] == air
assert block[1,1988,59005,1022] == air
assert block[1,1988,59003,1022] == air
assert block[1,1986,59004,1021] != air
assert level[1,1986,59004,1023] == 0
tick 1
assert level[1,1986,59004,1023] > 0
tick 2
assert level[1,1986,59004,1022] > 0
aim -2 0 -2.0
shot 04_shore_pit_filling
tick 200
assert queued == 0
assert level[1,1986,59004,1022] == 255
assert level[1,1987,59004,1022] == 255
assert level[1,1988,59005,1022] == 255
assert level[1,1987,59004,1023] >= 200
assert level[1,1985,59004,1023] >= 230
# C2: the deficit levels out a little wider (the spread's remainder stays
# with the spreading cell), so 20 cells off the surface rests a lean below full
assert level[1,1965,59004,1023] >= 250
assert level[1,1946,59004,1023] == 255
assert water_in == 0
assert water_out == 0
assert water_lost == 0
aim -2 0 -2.0
shot 05_shore_pit_full

# ---- 5. a channel inland from the pit, dug under the feet: it floods, the
#         sea stays full
aim 0 0 -1.5
assert crosshair == sand
tap break
aim 0 0 -2.5
tap break
aim 1 0 -1.5
tap break
aim 1 0 -2.5
tap break
assert block[1,1989,59004,1024] == air
assert block[1,1989,59004,1022] == air
assert block[1,1990,59004,1022] == air
assert block[1,1990,59004,1021] != air
tick 3
assert level[1,1989,59004,1022] > 0
tick 200
assert queued == 0
assert level[1,1989,59004,1022] == 255
assert level[1,1990,59004,1022] == 255
assert level[1,1990,59004,1023] >= 150
assert level[1,1965,59004,1023] >= 250
assert level[1,1946,59004,1023] == 255
assert water_in == 0
assert water_out == 0
atblock 1 1993 59004 1023
mode fly
hold space 0.1
aim -4 0 -2.0
shot 06_channel

# ---- 6. the tick budget at this activity, and the frame rate ----------------
assert tick_ms_avg < 2
state final
bench 60
